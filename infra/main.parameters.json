{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "tenantId": { "value": "${AZURE_TENANT_ID}" },
    "routingConfigJson": { "value": "${DEVICE_NOTIFICATION_ROUTING_JSON}" },
    "adminEmailRecipients": { "value": "${ADMIN_EMAIL_RECIPIENTS=}" },
    "emailSenderUpn": { "value": "${EMAIL_SENDER_UPN=}" },
    "teamsAdminWebhookUrl": { "value": "${TEAMS_ADMIN_WEBHOOK_URL=}" },
    "entraPollSchedule": { "value": "${ENTRA_POLL_SCHEDULE}" },
    "intunePollSchedule": { "value": "${INTUNE_POLL_SCHEDULE}" },
    "enrollmentLookbackHours": { "value": "${ENROLLMENT_LOOKBACK_HOURS}" },
    "auditOverlapMinutes": { "value": "${ENTRA_AUDIT_OVERLAP_MINUTES}" },
    "collectionEnabled": { "value": "${DEVICE_NOTIFICATION_COLLECTION_ENABLED=false}" }
  }
}
